# GEMINI_API_KEY: Optional. Used for AI synthesis when available.
# Universal company identification and web search also work without this key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional external web search providers (the built-in public search works without them):
# SERPER_API_KEY=""
# GOOGLE_CSE_API_KEY=""
# GOOGLE_CSE_CX=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
